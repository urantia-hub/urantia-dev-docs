{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "urantia.dev",
  "colors": {
    "primary": "#8a5a00",
    "light": "#f2b441",
    "dark": "#0f2a2e"
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "light"
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Demo",
        "href": "https://demo.urantia.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "https://docs.urantia.dev/quickstart"
    }
  },
  "thumbnails": {
    "appearance": "light",
    "background": "/images/thumbnail-background.png",
    "fonts": {
      "family": "Inter"
    }
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:site_name": "urantia.dev",
      "og:type": "website"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart", "use-cases", "changelog", "help"]
          },
          {
            "group": "Data",
            "pages": ["papers", "paragraphs", "verify-quotes", "entities", "bible", "scriptures", "audio", "video", "cdn"]
          },
          {
            "group": "SDKs",
            "pages": ["sdks/overview", "sdks/api", "sdks/auth"]
          },
          {
            "group": "Integrations",
            "pages": ["assistants", "mcp-servers", "ai-agents", "feedback"]
          },
          {
            "group": "Open Source",
            "pages": ["open-source", "preservation"]
          },
          {
            "group": "Support",
            "pages": ["support"]
          },
          {
            "group": "Legal",
            "pages": ["terms-of-service", "privacy-policy"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Table of Contents",
            "pages": ["api-reference/endpoint/get-toc"]
          },
          {
            "group": "Papers",
            "pages": [
              "api-reference/endpoint/list-papers",
              "api-reference/endpoint/get-paper",
              "api-reference/endpoint/get-paper-sections"
            ]
          },
          {
            "group": "Paragraphs",
            "pages": [
              "api-reference/endpoint/get-random-paragraph",
              "api-reference/endpoint/get-paragraph",
              "api-reference/endpoint/get-paragraph-context"
            ]
          },
          {
            "group": "Entities",
            "pages": [
              "api-reference/endpoint/list-entities",
              "api-reference/endpoint/get-entity",
              "api-reference/endpoint/get-entity-paragraphs"
            ]
          },
          {
            "group": "Search",
            "pages": [
              "api-reference/endpoint/search",
              "api-reference/endpoint/semantic-search"
            ]
          },
          {
            "group": "Bible",
            "pages": [
              "api-reference/endpoint/list-bible-books",
              "api-reference/endpoint/get-bible-book",
              "api-reference/endpoint/get-bible-chapter",
              "api-reference/endpoint/get-bible-verse",
              "api-reference/endpoint/get-bible-verse-urantia-parallels",
              "api-reference/endpoint/bible-semantic-search"
            ]
          },
          {
            "group": "World religions",
            "pages": [
              "api-reference/endpoint/list-scriptures",
              "api-reference/endpoint/get-scripture",
              "api-reference/endpoint/get-scripture-passages",
              "api-reference/endpoint/get-scripture-urantia-parallels",
              "api-reference/endpoint/scripture-semantic-search"
            ]
          },
          {
            "group": "Audio",
            "pages": ["api-reference/endpoint/get-audio"]
          },
          {
            "group": "Citation",
            "pages": ["api-reference/endpoint/get-citation"]
          },
          {
            "group": "OG Images",
            "pages": ["api-reference/endpoint/get-og-image"]
          },
          {
            "group": "Embeddings",
            "pages": [
              "api-reference/endpoint/get-embedding",
              "api-reference/endpoint/export-embeddings"
            ]
          },
          {
            "group": "Feedback",
            "pages": ["api-reference/endpoint/submit-feedback"]
          }
        ]
      },
      {
        "tab": "Tutorials",
        "groups": [
          {
            "group": "Tutorials",
            "pages": ["blog/daily-quote-bot", "blog/building-urantia-ai-chatbot", "blog/mcp-server-urantia-book"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://urantia.dev"
  },
  "api": {
    "baseUrl": "https://api.urantia.dev"
  },
  "openapi": "api-reference/openapi.json",
  "redirects": [
    { "source": "/concepts/:slug*", "destination": "/" },
    { "source": "/quotes/:slug*", "destination": "/" },
    { "source": "/blog/urantia-book-for-beginners", "destination": "/" },
    { "source": "/blog/religious-text-apis-compared", "destination": "/" }
  ],
  "footer": {
    "socials": {
      "website": "https://urantia.dev",
      "github": "https://github.com/urantia-hub/urantia-dev-api"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Docs",
            "href": "https://docs.urantia.dev/"
          },
          {
            "label": "API reference",
            "href": "https://docs.urantia.dev/api-reference/introduction"
          },
          {
            "label": "Demo",
            "href": "https://demo.urantia.dev/"
          },
          {
            "label": "Changelog",
            "href": "https://docs.urantia.dev/changelog"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "Quickstart",
            "href": "https://docs.urantia.dev/quickstart"
          },
          {
            "label": "MCP server",
            "href": "https://docs.urantia.dev/mcp-servers"
          },
          {
            "label": "TypeScript SDK",
            "href": "https://docs.urantia.dev/sdks/overview"
          },
          {
            "label": "OpenAPI spec",
            "href": "https://api.urantia.dev/openapi.json"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/urantia-hub/urantia-dev-api"
          }
        ]
      },
      {
        "header": "Project",
        "items": [
          {
            "label": "Help",
            "href": "https://docs.urantia.dev/help"
          },
          {
            "label": "Report a problem",
            "href": "https://docs.urantia.dev/feedback"
          },
          {
            "label": "Support the project",
            "href": "https://docs.urantia.dev/support"
          },
          {
            "label": "Status",
            "href": "https://status.urantia.dev/"
          },
          {
            "label": "Terms",
            "href": "https://docs.urantia.dev/terms-of-service"
          },
          {
            "label": "Privacy",
            "href": "https://docs.urantia.dev/privacy-policy"
          }
        ]
      }
    ]
  }
}
